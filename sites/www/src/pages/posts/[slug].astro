---
import { render } from "astro:content";
import defaultMdxComponents from "fumadocs-ui/mdx";
import Layout from "@/components/layout.astro";
import Footer from "@/components/landing/footer.astro";
import { Header } from "@/components/landing/header";
import { Picker } from "@/components/landing/picker";
import { Placeholder } from "@/components/placeholder";
import { formatDate } from "@/lib/date";
import { getPosts, type Post } from "@/lib/posts";
import "@/styles/posts.css";

interface Props {
	post: Post;
}

export async function getStaticPaths() {
	return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, tag } = post.data;
const { Content } = await render(post);
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	datePublished: date.toISOString(),
	dateModified: (updated ?? date).toISOString(),
	url: new URL(Astro.url.pathname, Astro.site).href,
	author: { "@type": "Organization", name: "CodeWork", url: Astro.site?.href },
	publisher: { "@type": "Organization", name: "CodeWork", url: Astro.site?.href },
};
---

<Layout title={`${title} | CodeWork`} description={description} type="article">
	<Fragment slot="head">
		<meta property="article:published_time" content={date.toISOString()} />
		{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</Fragment>
	<Header client:load />
	<Picker client:load />
	<main class="mx-auto min-h-[calc(100svh-var(--nav-h))] max-w-3xl px-4 py-12 sm:px-6 lg:py-20">
		<article>
			<header>
				<div class="flex flex-wrap items-center gap-3 font-mono text-xs text-text-muted">
					<span class="text-brand uppercase tracking-wider">{tag}</span>
					<time datetime={date.toISOString()}>{formatDate(date)}</time>
					{updated && <span>Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
				</div>
				<h1 class="mt-3 text-3xl font-semibold tracking-tight text-balance text-text sm:text-4xl">{title}</h1>
				<p class="mt-4 text-lg leading-relaxed text-text-secondary text-pretty">{description}</p>
			</header>
			<div class="prose mt-10 max-w-none">
				<Content components={{ ...defaultMdxComponents, Placeholder }} />
			</div>
		</article>
	</main>
	<Footer />
</Layout>
