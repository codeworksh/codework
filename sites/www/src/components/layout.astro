---
import { ClientRouter } from "astro:transitions";
import { GITHUB_URL } from "@/components/landing/content";
import { themeInitScript } from "@/components/landing/theme";
import "@/lib/react";

interface Props {
	title: string;
	description?: string | undefined;
	/** Docs pages swap in place through Astro's client router; the landing page is a plain document. */
	docs?: boolean;
	/** Open Graph type; posts are articles. */
	type?: "website" | "article";
}

const { title, description, docs = false, type = "website" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Ties every page to this CodeWork, so search engines don't confuse it with others of the same name.
const schema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: "CodeWork",
	description: "CodeWork is an open source AI coding agent for your terminal, editor or server.",
	url: Astro.site,
	applicationCategory: "DeveloperApplication",
	operatingSystem: "macOS, Linux",
	license: `${GITHUB_URL}/blob/main/LICENSE`,
	offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
	sameAs: [GITHUB_URL, "https://www.npmjs.com/package/@codeworksh/cli"],
};
---

<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<link rel="icon" type="image/x-icon" href="/brand/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
		<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" sizes="180x180" />
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="CodeWork Posts" href="/rss.xml" />
		<meta property="og:site_name" content="CodeWork" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL("/og.png", Astro.site)} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
		<slot name="head" />
		{docs && <ClientRouter />}
		<script is:inline set:html={themeInitScript} />
		<script>
			// MDX code blocks render as static HTML, so their copy buttons are wired here, once, for every page.
			document.addEventListener("click", async (event) => {
				const button = (event.target as Element).closest<HTMLButtonElement>('figure button[aria-label="Copy Text"]');
				const code = button?.closest("figure")?.querySelector("pre");
				if (!button || !code) return;
				await navigator.clipboard.writeText(code.innerText.trimEnd());
				button.dataset.checked = "";
				setTimeout(() => delete button.dataset.checked, 1500);
			});
		</script>
	</head>
	{
		docs ? (
			<body class="flex min-h-screen flex-col" transition:animate="none" transition:name="page-layout">
				<slot />
			</body>
		) : (
			<body>
				<slot />
			</body>
		)
	}
</html>
