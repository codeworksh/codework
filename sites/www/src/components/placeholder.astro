---
/**
 * Stands in for a screenshot or video that has not been made yet. `label` says what the final
 * asset should show, so swapping it for the real `![]()` or `<video>` later needs no guesswork.
 */
interface Props {
	label: string;
	kind?: "image" | "video";
}

const { label, kind = "image" } = Astro.props;
---

<figure
	class="not-prose my-6 flex aspect-video flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-fd-border bg-fd-muted px-6 text-center text-fd-muted-foreground"
	data-placeholder={kind}
>
	<span class="font-mono text-xs uppercase tracking-wider">{kind === "video" ? "Video" : "Screenshot"} placeholder</span>
	<figcaption class="text-sm">{label}</figcaption>
</figure>
