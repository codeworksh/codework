{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"lib": ["es2023"],
		"composite": true,
		"incremental": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"noEmit": false,
		"noUnusedLocals": false,
		"rootDir": "src",
		"outDir": "dist/types",
		"tsBuildInfoFile": "../../.cache/typescript/aikit.tsbuildinfo"
	},
	"include": ["src"],
	"references": [{ "path": "../utils" }]
}
