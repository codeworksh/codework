{
	"name": "@codeworksh/aikit",
	"version": "0.9.0",
	"description": "TypeScript SDK that provides a unified API for working with multiple LLM providers, automatic model discovery, and more.",
	"keywords": [
		"agent",
		"ai",
		"ai-sdk",
		"anthropic",
		"grok",
		"harness",
		"llm",
		"node",
		"openai"
	],
	"homepage": "https://www.codework.sh",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/aikit"
	},
	"bin": {
		"aikit": "./dist/pack/cli.mjs"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./oauth/openai/codex": {
			"development": "./src/oauth/openai/codex.ts",
			"types": "./dist/pack/oauth/openai/codex.d.mts",
			"import": "./dist/pack/oauth/openai/codex.mjs",
			"default": "./dist/pack/oauth/openai/codex.mjs"
		},
		"./oauth/github/copilot": {
			"development": "./src/oauth/github/copilot.ts",
			"types": "./dist/pack/oauth/github/copilot.d.mts",
			"import": "./dist/pack/oauth/github/copilot.mjs",
			"default": "./dist/pack/oauth/github/copilot.mjs"
		},
		"./oauth/summary": {
			"development": "./src/oauth/summary.ts",
			"types": "./dist/pack/oauth/summary.d.mts",
			"import": "./dist/pack/oauth/summary.mjs",
			"default": "./dist/pack/oauth/summary.mjs"
		},
		"./oauth/interactive": {
			"development": "./src/oauth/interactive.ts",
			"types": "./dist/pack/oauth/interactive.d.mts",
			"import": "./dist/pack/oauth/interactive.mjs",
			"default": "./dist/pack/oauth/interactive.mjs"
		},
		"./modelgen": {
			"development": "./src/modelgen.ts",
			"types": "./dist/pack/modelgen.d.mts",
			"import": "./dist/pack/modelgen.mjs",
			"default": "./dist/pack/modelgen.mjs"
		},
		"./failure": {
			"development": "./src/llm/failure.ts",
			"types": "./dist/pack/llm/failure.d.mts",
			"import": "./dist/pack/llm/failure.mjs",
			"default": "./dist/pack/llm/failure.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"cli": "tsx --conditions=development src/cli.ts",
		"lint": "vp lint",
		"release": "node ../../scripts/publish.mjs aikit",
		"release:dev": "node ../../scripts/publish.mjs aikit --dev",
		"release:dry": "node ../../scripts/publish.mjs aikit --dry-run",
		"test": "vp test --exclude \"test/e2e/**\"",
		"test:e2e": "vp test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^4.0.53",
		"@ai-sdk/google": "^4.0.69",
		"@ai-sdk/google-vertex": "^5.0.81",
		"@ai-sdk/openai": "^4.0.66",
		"@ai-sdk/openai-compatible": "^3.0.48",
		"@ai-sdk/provider": "^4.0.14",
		"@ai-sdk/xai": "^4.0.58",
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"ai": "^7.0.99",
		"dedent": "^1.7.2",
		"eventsource-parser": "^4.1.0",
		"partial-json": "^0.1.7",
		"remeda": "^2.48.0",
		"typebox": "^1.3.30",
		"uuidv7": "^1.2.1",
		"yargs": "^18.1.0"
	},
	"devDependencies": {
		"@types/yargs": "^17.0.35",
		"bumpp": "^12.3.0",
		"tsx": "^4.23.13"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
