			"default": "./dist/pack/sandbox/io.mjs"
		},
		"./sandbox/driver": {
			"development": "./src/sandbox/driver.ts",
			"types": "./dist/pack/sandbox/driver.d.mts",
			"import": "./dist/pack/sandbox/driver.mjs",
			"default": "./dist/pack/sandbox/driver.mjs"
		},
		"./sandbox/errors": {
			"development": "./src/sandbox/errors.ts",
			"types": "./dist/pack/sandbox/errors.d.mts",
