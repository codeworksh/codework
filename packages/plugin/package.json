		},
		"./ids": {
			"development": "./src/ids.ts",
			"types": "./dist/pack/ids.d.mts",
			"import": "./dist/pack/ids.mjs",
			"default": "./dist/pack/ids.mjs"
		},
		"./location": {
			"development": "./src/location.ts",
			"types": "./dist/pack/location.d.mts",
			"import": "./dist/pack/location.mjs",
			"default": "./dist/pack/location.mjs"
		},
		"./project": {
			"development": "./src/project.ts",
			"types": "./dist/pack/project.d.mts",
			"import": "./dist/pack/project.mjs",
			"default": "./dist/pack/project.mjs"
		},
		"./repo": {
			"development": "./src/repo.ts",
			"types": "./dist/pack/repo.d.mts",
			"import": "./dist/pack/repo.mjs",
			"default": "./dist/pack/repo.mjs"
		},
		"./space": {
			"development": "./src/space.ts",
			"types": "./dist/pack/space.d.mts",
			"import": "./dist/pack/space.mjs",
			"default": "./dist/pack/space.mjs"
		},
		"./settings": {
			"development": "./src/settings.ts",
			"types": "./dist/pack/settings.d.mts",
			"import": "./dist/pack/settings.mjs",
			"default": "./dist/pack/settings.mjs"
		},
		"./schema": {
			"development": "./src/schema.ts",
			"types": "./dist/pack/schema.d.mts",
			"import": "./dist/pack/schema.mjs",
			"default": "./dist/pack/schema.mjs"
		},
		"./posix": {
			"development": "./src/posix.ts",
			"types": "./dist/pack/posix.d.mts",
			"import": "./dist/pack/posix.mjs",
			"default": "./dist/pack/posix.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text",
		"lint": "vp lint",
		"release": "node ../../scripts/publish.mjs plugin",
		"release:dev": "node ../../scripts/publish.mjs plugin --dev --latest",
		"release:dry": "node ../../scripts/publish.mjs plugin --dry-run",
		"test": "vp test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"tslib": "^2.8.1",
		"typebox": "^1.3.30",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@types/node": "^26.5.1",
		"bumpp": "^12.3.0",
		"effect": "4.0.0-rc.115"
	},
	"peerDependencies": {
		"effect": "4.0.0-rc.115"
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
