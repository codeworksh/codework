			"default": "./dist/pack/tool.mjs"
		},
		"./tool/error": {
			"development": "./src/tool/error.ts",
			"types": "./dist/pack/tool/error.d.mts",
			"import": "./dist/pack/tool/error.mjs",
			"default": "./dist/pack/tool/error.mjs"
		},
		"./tool/progress": {
			"development": "./src/tool/progress.ts",
			"types": "./dist/pack/tool/progress.d.mts",
			"import": "./dist/pack/tool/progress.mjs",
			"default": "./dist/pack/tool/progress.mjs"
		},
		"./event": {
			"development": "./src/event.ts",
