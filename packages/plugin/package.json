			"import": "./dist/pack/sandbox/error.mjs",
			"default": "./dist/pack/sandbox/error.mjs"
		},
		"./sandbox/instance": {
			"development": "./src/sandbox/instance.ts",
			"types": "./dist/pack/sandbox/instance.d.mts",
			"import": "./dist/pack/sandbox/instance.mjs",
			"default": "./dist/pack/sandbox/instance.mjs"
		},
		"./sandbox/filesystem": {
			"development": "./src/sandbox/filesystem.ts",
			"types": "./dist/pack/sandbox/filesystem.d.mts",
			"import": "./dist/pack/sandbox/filesystem.mjs",
			"default": "./dist/pack/sandbox/filesystem.mjs"
		},
		"./sandbox/shell": {
			"development": "./src/sandbox/shell.ts",
			"types": "./dist/pack/sandbox/shell.d.mts",
			"import": "./dist/pack/sandbox/shell.mjs",
			"default": "./dist/pack/sandbox/shell.mjs"
		},
		"./sandbox/resource": {
