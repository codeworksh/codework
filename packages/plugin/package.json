{
	"name": "@codeworksh/plugin",
	"version": "0.0.1",
	"description": "SDK for building CodeWork plugins — the plugin, tool, and sandbox contracts shared with @codeworksh/harness.",
	"keywords": [
		"agent",
		"ai",
		"codework",
		"harness",
		"llm",
		"plugin",
		"sdk",
		"tool"
	],
	"homepage": "https://www.codework.sh",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/plugin"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./plugin": {
			"development": "./src/plugin.ts",
			"types": "./dist/pack/plugin.d.mts",
			"import": "./dist/pack/plugin.mjs",
			"default": "./dist/pack/plugin.mjs"
		},
		"./plugin/tool": {
			"development": "./src/plugin/tool.ts",
			"types": "./dist/pack/plugin/tool.d.mts",
			"import": "./dist/pack/plugin/tool.mjs",
			"default": "./dist/pack/plugin/tool.mjs"
		},
		"./plugin/prompt": {
			"development": "./src/plugin/prompt.ts",
			"types": "./dist/pack/plugin/prompt.d.mts",
			"import": "./dist/pack/plugin/prompt.mjs",
			"default": "./dist/pack/plugin/prompt.mjs"
		},
		"./sandbox": {
			"development": "./src/sandbox.ts",
