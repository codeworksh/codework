{
	"$schema": "../../node_modules/@effect/tsgo/schema.json",
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"tsBuildInfoFile": "../../.cache/typescript/plugin.tsbuildinfo",
		"paths": {
			"@codeworksh/aikit": ["../aikit/dist/pack/index.d.mts"],
			"@codeworksh/aikit/failure": ["../aikit/src/llm/failure.ts"],
			"@codeworksh/aikit/modelgen": ["../aikit/dist/pack/modelgen.d.mts"]
		},
		"plugins": [
			{
				"name": "@effect/language-service",
				"diagnostics": true,
				"refactors": true,
				"namespaceImportPackages": ["@effect/platform-node", "effect"],
				"diagnosticSeverity": {
					"importFromBarrel": "error",
					"anyUnknownInErrorContext": "error",
					"unsafeEffectTypeAssertion": "error",
					"instanceOfSchema": "error",
					"deterministicKeys": "error",
					"strictEffectProvide": "off",
					"missingEffectServiceDependency": "error",
					"leakingRequirements": "error",
					"globalErrorInEffectCatch": "error",
					"globalErrorInEffectFailure": "error",
					"unknownInEffectCatch": "error",
					"strictBooleanExpressions": "off",
					"lazyEffect": "off",
					"preferSchemaOverJson": "error",
					"schemaSyncInEffect": "error",
					"cryptoRandomUUID": "error",
					"cryptoRandomUUIDInEffect": "error",
					"nodeBuiltinImport": "error",
					"globalDate": "error",
					"globalDateInEffect": "error",
					"globalConsole": "error",
					"globalConsoleInEffect": "error",
					"globalRandom": "error",
					"globalRandomInEffect": "error",
					"globalTimers": "error",
					"globalTimersInEffect": "error",
					"globalFetch": "error",
					"globalFetchInEffect": "error"
				},
				/*
				 * Tests are the host boundary: they build temp directories, read fixture JSON, and
				 * need wall-clock values and distinct ids, so the rules that push production code
				 * onto Effect's own APIs do not apply to them. Nor do the ergonomic ones: a case
				 * subscribes for its own duration and lets the scope close rather than threading an
				 * unsubscribe handle, wires layers per assertion, and fabricates plain errors to
				 * fail on purpose. What stays on is everything that would make a test lie —
				 * type assertions, `instanceof` on schemas, and a generator without a definite exit.
				 */
				"overrides": [
					{
						"include": ["test/**/*.ts"],
						"options": {
							"diagnosticSeverity": {
								"nodeBuiltinImport": "off",
								"preferSchemaOverJson": "off",
								"globalDate": "off",
								"globalDateInEffect": "off",
								"cryptoRandomUUID": "off",
								"cryptoRandomUUIDInEffect": "off",
								"globalTimers": "off",
								"globalTimersInEffect": "off",
								"globalRandom": "off",
								"globalRandomInEffect": "off",
								"preferTypedSchemaDecoder": "off",
								"floatingEffect": "off",
								"multipleEffectProvide": "off",
								"unnecessaryEffectGen": "off",
								"acquireReleaseDisposable": "off",
								"globalErrorInEffectFailure": "off",
								"layerMergeAllWithDependencies": "off",
								"anyUnknownInErrorContext": "off",
								"schemaNumber": "off"
							}
						}
					}
				]
			}
		]
	},
	"include": ["src", "test"]
}
