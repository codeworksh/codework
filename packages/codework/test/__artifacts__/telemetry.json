{
	"resource": {
		"codework.command": "run",
		"deployment.environment.name": "latest",
		"service.instance.id": "<volatile>",
		"service.name": "codework",
		"service.version": "<volatile>"
	},
	"exported": [
		"(root) > CLI.run",
		"CLI.run > CLI.selectSandbox",
		"CLI.run > Loop.run",
		"CLI.selectSandbox > Sandbox.resolve",
		"Loop.run > Loop.runTurn",
		"Loop.runTurn > Loop.runTurnAttempt",
		"Loop.runTurnAttempt > LLM.run",
		"Loop.runTurnAttempt > Loop.settleTools",
		"Loop.settleTools > Loop.handleTool"
	],
	"spans": [
		{
			"name": "Loop.run",
			"kind": "internal",
			"parent": null,
			"error": false,
			"attributes": {
				"gen_ai.agent.name": "codework",
				"gen_ai.conversation.id": "<volatile>",
				"gen_ai.operation.name": "invoke_agent"
			}
		},
		{
			"name": "LLM.run",
			"kind": "client",
			"parent": "Loop.run",
			"error": true,
			"attributes": {
				"error.type": "Runner.ProviderUnavailableError",
				"gen_ai.conversation.id": "<volatile>",
				"gen_ai.operation.name": "chat",
				"gen_ai.provider.name": "otel",
				"gen_ai.request.model": "otel-model",
				"gen_ai.request.stream": true,
				"gen_ai.response.finish_reasons": [
					"error"
				],
				"gen_ai.response.model": "otel-model",
				"gen_ai.usage.cache_read.input_tokens": 0,
				"gen_ai.usage.cache_write.input_tokens": 0,
				"gen_ai.usage.input_tokens": 0,
				"gen_ai.usage.output_tokens": 0
			}
		},
		{
			"name": "LLM.run",
			"kind": "client",
			"parent": "Loop.run",
			"error": false,
			"attributes": {
				"gen_ai.conversation.id": "<volatile>",
				"gen_ai.operation.name": "chat",
				"gen_ai.provider.name": "otel",
				"gen_ai.request.model": "otel-model",
				"gen_ai.request.stream": true,
				"gen_ai.response.finish_reasons": [
					"toolUse"
				],
				"gen_ai.response.id": "<volatile>",
				"gen_ai.response.model": "otel-model",
				"gen_ai.response.time_to_first_chunk": "<volatile>",
				"gen_ai.usage.cache_read.input_tokens": 0,
				"gen_ai.usage.cache_write.input_tokens": 0,
				"gen_ai.usage.input_tokens": 120,
				"gen_ai.usage.output_tokens": 8,
				"gen_ai.usage.reasoning.output_tokens": 0
			}
		},
		{
			"name": "Loop.handleTool",
			"kind": "internal",
			"parent": "Loop.run",
			"error": false,
			"attributes": {
				"gen_ai.operation.name": "execute_tool",
				"gen_ai.tool.call.id": "<volatile>",
				"gen_ai.tool.name": "bash"
			}
		},
		{
			"name": "LLM.run",
			"kind": "client",
			"parent": "Loop.run",
			"error": false,
			"attributes": {
				"gen_ai.conversation.id": "<volatile>",
				"gen_ai.operation.name": "chat",
				"gen_ai.provider.name": "otel",
				"gen_ai.request.model": "otel-model",
				"gen_ai.request.stream": true,
				"gen_ai.response.finish_reasons": [
					"stop"
				],
				"gen_ai.response.id": "<volatile>",
				"gen_ai.response.model": "otel-model",
				"gen_ai.response.time_to_first_chunk": "<volatile>",
				"gen_ai.usage.cache_read.input_tokens": 0,
				"gen_ai.usage.cache_write.input_tokens": 0,
				"gen_ai.usage.input_tokens": 120,
				"gen_ai.usage.output_tokens": 8,
				"gen_ai.usage.reasoning.output_tokens": 0
			}
		}
	],
	"metrics": {
		"child_fiber_failures": {
			"unit": "1",
			"type": "sum",
			"series": [
				{
					"attributes": {}
				}
			]
		},
		"child_fiber_successes": {
			"unit": "1",
			"type": "sum",
			"series": [
				{
					"attributes": {}
				}
			]
		},
		"child_fibers_active": {
			"unit": "1",
			"type": "gauge",
			"series": [
				{
					"attributes": {}
				}
			]
		},
		"child_fibers_started": {
			"unit": "1",
			"type": "sum",
			"series": [
				{
					"attributes": {}
				}
			]
		},
		"codework.agent.duration": {
			"unit": "s",
			"type": "histogram",
			"series": [
				{
					"attributes": {
						"unit": "s"
					},
					"count": 1
				}
			]
		},
		"codework.llm.cost": {
			"unit": "USD",
			"type": "sum",
			"series": [
				{
					"attributes": {
						"model": "otel-model",
						"provider": "otel",
						"unit": "USD"
					},
					"value": 0.00096
				}
			]
		},
		"codework.llm.duration": {
			"unit": "s",
			"type": "histogram",
			"series": [
				{
					"attributes": {
						"error": "Runner.ProviderUnavailableError",
						"model": "otel-model",
						"provider": "otel",
						"unit": "s"
					},
					"count": 1
				},
				{
					"attributes": {
						"model": "otel-model",
						"provider": "otel",
						"unit": "s"
					},
					"count": 2
				}
			]
		},
		"codework.llm.tokens": {
			"unit": "{token}",
			"type": "sum",
			"series": [
				{
					"attributes": {
						"model": "otel-model",
						"provider": "otel",
						"type": "input",
						"unit": "{token}"
					},
					"value": 240
				},
				{
					"attributes": {
						"model": "otel-model",
						"provider": "otel",
						"type": "output",
						"unit": "{token}"
					},
					"value": 16
				}
			]
		},
		"codework.llm.ttft": {
			"unit": "s",
			"type": "histogram",
			"series": [
				{
					"attributes": {
						"model": "otel-model",
						"provider": "otel",
						"unit": "s"
					},
					"count": 2
				}
			]
		},
		"codework.sandbox.exec.duration": {
			"unit": "s",
			"type": "histogram",
			"series": [
				{
					"attributes": {
						"driver": "local",
						"unit": "s"
					},
					"count": 1
				}
			]
		},
		"codework.tool.duration": {
			"unit": "s",
			"type": "histogram",
			"series": [
				{
					"attributes": {
						"tool": "bash",
						"unit": "s"
					},
					"count": 1
				}
			]
		}
	}
}
