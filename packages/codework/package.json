{
	"name": "@codeworksh/cli",
	"version": "0.0.1",
	"description": "CLI for running CodeWork coding agent harness.",
	"keywords": [
		"agent",
		"ai",
		"ai-sdk",
		"anthropic",
		"grok",
		"harness",
		"llm",
		"node",
		"openai"
	],
	"homepage": "https://www.codework.sh",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/codework"
	},
	"bin": {
		"codework": "./dist/pack/index.mjs"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text",
		"lint": "vp lint",
		"release": "node ../../scripts/publish.mjs cli",
		"release:dev": "node ../../scripts/publish.mjs cli --dev",
		"release:dry": "node ../../scripts/publish.mjs cli --dry-run",
		"test": "vp test",
		"start": "node --conditions=development src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"@codeworksh/plugin": "workspace:*",
		"@effect/platform-node": "4.0.0-rc.115",
		"@effect/platform-node-shared": "4.0.0-rc.115",
		"@effect/sql-sqlite-node": "4.0.0-rc.115",
		"@npmcli/arborist": "^10.0.2",
		"@npmcli/config": "^11.0.1",
		"@platformatic/vfs": "^0.4.0",
		"effect": "4.0.0-rc.115",
		"jsonc-parser": "3.3.1",
		"just-bash": "^3.4.2",
		"npm-package-arg": "^14.0.0",
		"pacote": "^22.0.0",
		"tslib": "^2.8.1",
		"typebox": "^1.3.30",
		"uuid": "^14.0.2",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@codeworksh/harness": "workspace:*",
		"@daytona/sdk": "^0.211.2",
		"@types/node": "catalog:",
		"@vercel/sandbox": "^3.3.0",
		"bumpp": "^12.3.0"
	},
	"peerDependencies": {
		"@daytona/sdk": "*",
		"@vercel/sandbox": "*"
	},
	"peerDependenciesMeta": {
		"@daytona/sdk": {
			"optional": true
		},
		"@vercel/sandbox": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
