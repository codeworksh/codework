{
	"name": "@codeworksh/cli",
	"version": "0.0.1",
	"description": "CodeWork command line interface.",
	"keywords": [
		"agent",
		"ai",
		"cli",
		"codework",
		"coding-agent",
		"typescript"
	],
	"homepage": "https://github.com/codeworksh/codework/tree/main/packages/codework",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/codework"
	},
	"bin": {
		"codework": "./dist/pack/index.mjs"
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text",
		"lint": "vp lint",
		"test": "vp test",
		"typecheck": "tsc --noEmit",
		"cli": "node --conditions=development src/index.ts"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"@effect/platform-node": "4.0.0-beta.107",
		"@effect/sql-sqlite-node": "4.0.0-beta.107",
		"@platformatic/vfs": "^0.4.0",
		"effect": "4.0.0-beta.107",
		"just-bash": "^2.14.5",
		"tslib": "^2.8.1",
		"typebox": "^1.3.10",
		"uuid": "^14.0.1",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@codeworksh/harness": "workspace:*",
		"@daytona/sdk": "^0.187.0",
		"@types/node": "catalog:",
		"@vercel/sandbox": "^2.9.2",
		"bumpp": "^12.2.0"
	},
	"peerDependencies": {
		"@daytona/sdk": "*",
		"@vercel/sandbox": "*"
	},
	"peerDependenciesMeta": {
		"@daytona/sdk": {
			"optional": true
		},
		"@vercel/sandbox": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
