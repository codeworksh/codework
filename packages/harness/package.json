		"test": "vp test",
		"typecheck": "node ../../scripts/tsgo.mjs --noEmit"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"@daytona/sdk": "^0.187.0",
		"@effect/platform-node": "4.0.0-beta.107",
