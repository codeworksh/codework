{
	"name": "@codeworksh/harness",
	"version": "0.0.1",
	"description": "AI agent harness — agent loop, tools, plugins, sandbox, and more.",
	"keywords": [
		"agent",
		"ai",
		"anthropic",
		"openai",
		"grok",
		"ai-sdk",
		"llm",
		"harness",
		"sandbox",
		"node"
	],
	"homepage": "https://www.codework.sh",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/harness"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./effect": {
			"development": "./src/effect.ts",
			"types": "./dist/pack/effect.d.mts",
			"import": "./dist/pack/effect.mjs",
			"default": "./dist/pack/effect.mjs"
		},
		"./sandbox": {
			"development": "./src/sandbox.ts",
			"types": "./dist/pack/sandbox.d.mts",
			"import": "./dist/pack/sandbox.mjs",
			"default": "./dist/pack/sandbox.mjs"
		},
		"./sandboxes/daytona": {
			"development": "./src/sandboxes/daytona/index.ts",
			"types": "./dist/pack/sandboxes/daytona/index.d.mts",
			"import": "./dist/pack/sandboxes/daytona/index.mjs",
			"default": "./dist/pack/sandboxes/daytona/index.mjs"
		},
		"./sandboxes/vercel": {
			"development": "./src/sandboxes/vercel/index.ts",
			"types": "./dist/pack/sandboxes/vercel/index.d.mts",
			"import": "./dist/pack/sandboxes/vercel/index.mjs",
			"default": "./dist/pack/sandboxes/vercel/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text",
		"lint": "vp lint",
		"release": "node ../../scripts/publish.mjs harness",
		"release:dev": "node ../../scripts/publish.mjs harness --dev",
		"release:dry": "node ../../scripts/publish.mjs harness --dry-run",
		"test": "vp test",
		"test:sandbox:package": "node test/scripts/codework-sandbox-vercel-smoke.mjs",
		"test:sandbox:package:e2e": "node test/scripts/codework-sandbox-vercel-smoke.mjs --e2e",
		"test:sandbox:e2e": "CODEWORK_SANDBOX_E2E_REQUIRED=1 vp test --no-file-parallelism test/sandbox.vercel.e2e.test.ts test/sandbox.daytona.e2e.test.ts test/sandbox.remote.driver.e2e.test.ts test/tools.registry.remote.e2e.test.ts test/session.relink.e2e.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"@effect/platform-node": "4.0.0-rc.115",
		"@effect/platform-node-shared": "4.0.0-rc.115",
		"@effect/sql-sqlite-node": "4.0.0-rc.115",
		"@npmcli/arborist": "^10.0.2",
		"@npmcli/config": "^11.0.1",
		"@platformatic/vfs": "^0.4.0",
		"jsonc-parser": "3.3.1",
		"just-bash": "^3.4.2",
		"npm-package-arg": "^14.0.0",
		"pacote": "^22.0.0",
		"tslib": "^2.8.1",
		"typebox": "^1.3.30",
		"uuid": "^14.0.2",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@daytona/sdk": "^0.211.2",
		"@types/node": "^26.5.1",
		"@types/npm-package-arg": "^6.1.4",
		"@vercel/sandbox": "^3.3.0",
		"bumpp": "^12.3.0",
		"dedent": "^1.7.2",
		"effect": "4.0.0-rc.115"
	},
	"peerDependencies": {
		"@daytona/sdk": "*",
		"@vercel/sandbox": "*",
		"effect": "4.0.0-rc.115"
	},
	"peerDependenciesMeta": {
		"@daytona/sdk": {
			"optional": true
		},
		"@vercel/sandbox": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
