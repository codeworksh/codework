		"just-bash": "^2.14.5",
		"typebox": "^1.3.10",
		"uuid": "^14.0.1",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.5"
	},
	"peerDependencies": {
