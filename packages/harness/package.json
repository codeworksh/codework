{
	"name": "@codeworksh/harness",
	"version": "0.0.1",
	"description": "AI agent harness — agent loop, tools, and code execution sandbox.",
	"keywords": [
		"agent",
		"ai",
		"coding-agent",
		"harness",
		"tool-execution",
		"typescript"
	],
	"homepage": "https://github.com/codeworksh/codework/tree/main/packages/harness",
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"author": "Sanchit Kudari",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git",
		"directory": "packages/harness"
	},
	"bin": {
		"codework": "./dist/pack/cli/index.mjs"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"types": "./dist/pack/index.d.mts",
	"exports": {
		".": {
			"development": "./src/index.ts",
			"types": "./dist/pack/index.d.mts",
			"import": "./dist/pack/index.mjs",
			"default": "./dist/pack/index.mjs"
		},
		"./effect": {
			"development": "./src/effect.ts",
			"types": "./dist/pack/effect.d.mts",
			"import": "./dist/pack/effect.mjs",
			"default": "./dist/pack/effect.mjs"
		},
		"./sandbox": {
			"development": "./src/sandbox.ts",
			"types": "./dist/pack/sandbox.d.mts",
			"import": "./dist/pack/sandbox.mjs",
			"default": "./dist/pack/sandbox.mjs"
		},
		"./sandboxes/daytona": {
			"development": "./src/sandboxes/daytona/index.ts",
			"types": "./dist/pack/sandboxes/daytona/index.d.mts",
			"import": "./dist/pack/sandboxes/daytona/index.mjs",
			"default": "./dist/pack/sandboxes/daytona/index.mjs"
		},
		"./sandboxes/vercel": {
			"development": "./src/sandboxes/vercel/index.ts",
			"types": "./dist/pack/sandboxes/vercel/index.d.mts",
			"import": "./dist/pack/sandboxes/vercel/index.mjs",
			"default": "./dist/pack/sandboxes/vercel/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"bump": "bumpp",
		"check": "vp check",
		"check:effect": "effect-tsgo diagnostics --project tsconfig.json --format text",
		"lint": "vp lint",
		"release": "node ../../scripts/publish.mjs harness",
		"release:dev": "node ../../scripts/publish.mjs harness --dev",
		"release:dry": "node ../../scripts/publish.mjs harness --dry-run",
		"test": "vp test",
		"test:sandbox:package": "node test/scripts/codework-sandbox-vercel-smoke.mjs",
		"test:sandbox:package:e2e": "node test/scripts/codework-sandbox-vercel-smoke.mjs --e2e",
		"test:sandbox:e2e": "CODEWORK_SANDBOX_E2E_REQUIRED=1 vp test --no-file-parallelism test/sandbox.vercel.e2e.test.ts test/sandbox.daytona.e2e.test.ts test/sandbox.remote.driver.e2e.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@codeworksh/aikit": "workspace:*",
		"@effect/platform-node": "4.0.0-beta.107",
		"@effect/sql-sqlite-node": "4.0.0-beta.107",
		"@platformatic/vfs": "^0.4.0",
		"effect": "4.0.0-beta.107",
		"just-bash": "^2.14.5",
		"tslib": "^2.8.1",
		"typebox": "^1.3.10",
		"uuid": "^14.0.1",
		"uuidv7": "^1.2.1"
	},
	"devDependencies": {
		"@codeworksh-test/codework-sandbox-vercel": "workspace:*",
		"@daytona/sdk": "^0.187.0",
		"@types/node": "^25.9.5",
		"@vercel/sandbox": "^2.9.2",
		"bumpp": "^12.2.0",
		"dedent": "^1.7.2"
	},
	"peerDependencies": {
		"@daytona/sdk": "*",
		"@vercel/sandbox": "*"
	},
	"peerDependenciesMeta": {
		"@daytona/sdk": {
			"optional": true
		},
		"@vercel/sandbox": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24.14.1"
	}
}
