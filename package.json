{
	"name": "codework",
	"version": "0.0.0",
	"private": true,
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git"
	},
	"workspaces": [
		"packages/*",
		"extras/*"
	],
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"build:packages": "vp run -r build",
		"bump:aikit": "pnpm --filter @codeworksh/aikit run bump",
		"bump:cli": "pnpm --filter @codeworksh/cli run bump",
		"bump:harness": "pnpm --filter @codeworksh/harness run bump",
		"bump:plugin": "pnpm --filter @codeworksh/plugin run bump",
		"check": "vp check",
		"check:packages": "vp run -r check",
		"cli": "vp run @codeworksh/cli#start",
		"lint": "vp lint",
		"prepare": "node scripts/clean-tsgo-backups.mjs && effect-tsgo patch --typescript --oxlint",
		"release:aikit": "pnpm --filter @codeworksh/aikit run release",
		"release:aikit:dev": "pnpm --filter @codeworksh/aikit run release:dev",
		"release:aikit:dry": "pnpm --filter @codeworksh/aikit run release:dry",
		"release:cli": "pnpm --filter @codeworksh/cli run release",
		"release:cli:dev": "pnpm --filter @codeworksh/cli run release:dev",
		"release:cli:dry": "pnpm --filter @codeworksh/cli run release:dry",
		"release:harness": "pnpm --filter @codeworksh/harness run release",
		"release:harness:dev": "pnpm --filter @codeworksh/harness run release:dev",
		"release:harness:dry": "pnpm --filter @codeworksh/harness run release:dry",
		"release:plugin": "pnpm --filter @codeworksh/plugin run release",
		"release:plugin:dev": "pnpm --filter @codeworksh/plugin run release:dev",
		"release:plugin:dry": "pnpm --filter @codeworksh/plugin run release:dry",
		"test": "vp test",
		"test:packages": "vp run -r test",
		"typecheck": "vp run -r --concurrency-limit 2 typecheck"
	},
	"devDependencies": {
		"@acme/codework-local-plugins": "workspace:*",
		"@acme/codework-prompt-life": "workspace:*",
		"@acme/codework-sandbox-vercel": "workspace:*",
		"@acme/codework-tool-proc": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@11.5.2"
}
