{
	"name": "codework",
	"version": "0.0.0",
	"private": true,
	"bugs": {
		"url": "https://github.com/codeworksh/codework/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeworksh/codework.git"
	},
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check",
		"check:packages": "vp run -r check",
		"dev:cli": "vp run --filter @codeworksh/cli start",
		"dev:desktop": "vp run --filter @codeworksh/desktop dev",
		"dev:www": "vp run --filter @codeworksh/www dev",
		"knip": "knip",
		"knip:check": "vp run knip:check:all",
		"knip:check:exports": "knip --exports --no-config-hints --workspace apps/web --workspace apps/desktop --workspace apps/contract --workspace apps/widget",
		"knip:check:files": "knip --include files,dependencies --no-config-hints",
		"lint": "vp lint",
		"prepare": "node scripts/clean-tsgo-backups.mjs && effect-tsgo patch --typescript --oxlint",
		"test": "vp test",
		"test:packages": "vp run -r test",
		"typecheck": "vp run -r --concurrency-limit 2 typecheck"
	},
	"devDependencies": {
		"@acme/codework-local-plugins": "workspace:*",
		"@acme/codework-prompt-life": "workspace:*",
		"@acme/codework-sandbox-vercel": "workspace:*",
		"@acme/codework-tool-proc": "workspace:*",
		"@effect/tsgo": "catalog:",
		"@shadcn/lint": "0.1.5",
		"@types/node": "catalog:",
		"eslint-plugin-better-tailwindcss": "4.10.0",
		"knip": "6.34.0",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"packageManager": "pnpm@12.14.0"
}
